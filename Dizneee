local function addLabel(text, height)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 0, height or 25)
    label.Font = Enum.Font.FredokaOne
    label.Text = text
    label.TextColor3 = C.white
    label.TextStrokeColor3 = C.black
    label.TextStrokeTransparency = 0
    label.TextSize = 19
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = content
    return label
end

local function addField(labelText, defaultText, order)
    addLabel(labelText, 24).LayoutOrder = order
    local box = Instance.new("TextBox")
    box.Name = labelText:gsub("%W", "") .. "Field"
    box.LayoutOrder = order + 1
    box.Size = UDim2.new(1, 0, 0, 44)
    box.BackgroundColor3 = C.field
    box.BorderSizePixel = 0
    box.ClearTextOnFocus = false
    box.Font = Enum.Font.FredokaOne
    box.Text = defaultText
    box.PlaceholderText = ""
    box.TextColor3 = C.white
    box.TextStrokeColor3 = C.black
    box.TextStrokeTransparency = 0
    box.TextSize = 20
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.Parent = content
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 16)
    local stroke = Instance.new("UIStroke")
    stroke.Color = C.borderSoft
    stroke.Thickness = 1.5
    stroke.Parent = box
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 14)
    pad.PaddingRight = UDim.new(0, 12)
    pad.Parent = box
    return box
end

local function addButton(text, color, order, callback)
    local button = Instance.new("TextButton")
    button.Name = text:gsub("%W", "") .. "Button"
    button.LayoutOrder = order
    button.Size = UDim2.new(1, 0, 0, 46)
    button.BackgroundColor3 = color
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Font = Enum.Font.FredokaOne
    button.Text = text
    button.TextColor3 = C.white
    button.TextStrokeColor3 = C.black
    button.TextStrokeTransparency = 0
    button.TextSize = 20
    button.Parent = content
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 17)
    local stroke = Instance.new("UIStroke")
    stroke.Color = C.borderSoft
    stroke.Transparency = 0.35
    stroke.Thickness = 1
    stroke.Parent = button

    local original = color
    local brighter = Color3.new(
        math.min(original.R + 0.13, 1),
        math.min(original.G + 0.13, 1),
        math.min(original.B + 0.13, 1)
    )
    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.08), {BackgroundColor3 = brighter}):Play()
    end)
    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.12), {BackgroundColor3 = original}):Play()
    end)
    button.Activated:Connect(function()
        if callback then callback() end
    end)
    return button
end

